---
import { X } from "lucide-react";
import RegistrationForm from "./RegistrationForm.astro";
---

<div
  id="registrationModal"
  class="fixed inset-0 z-[100] hidden items-center justify-center"
>
  <!-- Overlay -->
  <div
    class="absolute inset-0 bg-neutral-950/50 backdrop-blur-sm transition-opacity"
    id="modalOverlay"
  >
  </div>

  <!-- Modal Content Container -->
  <div
    class="relative z-10 w-full max-w-lg bg-surface rounded-[2rem] border border-brand-muted/15 shadow-2xl dark:shadow-black/50 p-8 lg:p-10 m-4 transform transition-all scale-95 opacity-0 duration-300 transition-colors"
    id="modalContent"
  >
    <!-- Close Button -->
    <button
      id="closeRegistrationModalBtn"
      class="absolute top-6 right-6 w-10 h-10 rounded-full bg-neutral-100 dark:bg-neutral-800 text-brand-muted hover:bg-neutral-200 dark:hover:bg-neutral-700 hover:text-brand-ink flex items-center justify-center transition-all cursor-pointer"
    >
      <X size={20} />
    </button>

    <span
      class="text-brand-blue uppercase tracking-[0.25em] text-xs font-semibold"
    >
      Get Started
    </span>

    <h3
      class="mt-3 text-3xl lg:text-4xl font-bold text-brand-ink leading-tight"
    >
      Create your profile
    </h3>

    <p class="mt-2 mb-8 text-brand-muted">
      Takes less than 60 seconds to join.
    </p>

    <!-- Injection of our responsive Form component -->
    <RegistrationForm />
  </div>
</div>

<script>
  const modal = document.getElementById("registrationModal");
  const overlay = document.getElementById("modalOverlay");
  const closeBtn = document.getElementById("closeRegistrationModalBtn");
  const content = document.getElementById("modalContent");

  const openTriggers = document.querySelectorAll(".open-register-modal");

  function openModal(e) {
    if (e && e.preventDefault) e.preventDefault();
    if (!modal || !content) return;

    const titleEl = content.querySelector("h3");
    if (titleEl) {
      if (
        e &&
        e.currentTarget &&
        e.currentTarget.dataset &&
        e.currentTarget.dataset.title
      ) {
        titleEl.textContent = e.currentTarget.dataset.title;
      } else {
        titleEl.textContent = "Create your profile";
      }
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";

    // Animate in
    setTimeout(() => {
      content.classList.remove("scale-95", "opacity-0");
      content.classList.add("scale-100", "opacity-100");
    }, 10);
  }

  window.addEventListener("open-registration-modal", openModal);

  function closeModal() {
    if (!modal || !content) return;

    content.classList.remove("scale-100", "opacity-100");
    content.classList.add("scale-95", "opacity-0");

    setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";

      // Also reset form inside modal when closing
      const form = modal.querySelector("form");
      if (form) {
        form.reset();
        const successMsg = form.querySelector(".success-message");
        if (successMsg) successMsg.classList.add("hidden");
      }
    }, 300); // match transition duration
  }

  openTriggers.forEach((trigger) => {
    trigger.addEventListener("click", openModal);
  });

  closeBtn?.addEventListener("click", closeModal);
  overlay?.addEventListener("click", closeModal);

  // ESC key to close
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>
