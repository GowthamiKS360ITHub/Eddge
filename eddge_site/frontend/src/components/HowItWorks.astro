---
import {
  ShoppingCart,
  Home as HomeIcon,
  Microscope,
  FileText,
  MessageCircle,
} from "lucide-react";

const steps = [
  {
    step: "01",
    icon: ShoppingCart,
    title: "Book your slot",
    desc: "We're in homes across India.",
  },
  {
    step: "02",
    icon: HomeIcon,
    title: "An expert visits at home",
    desc: "A trained Eddge Specialist comes to you, walks your child through a simple saliva sample. No Needles. No clinics. No commute. About thirty minutes, start to finish.",
  },
  {
    step: "03",
    icon: Microscope,
    title: "Lab work, done right",
    desc: "Your child's sample is processed in a certified lab, with the rigour the science deserves.",
  },
  {
    step: "04",
    icon: FileText,
    title: "Your report, in plain English",
    desc: "A parent-friendly read of what your child carries, what it means, and what to do with it.",
  },
  {
    step: "05",
    icon: MessageCircle,
    title: "A conversation, not a verdict",
    desc: "Sit with an expert counsellor. Walk out knowing your next step.",
  },
];
---

<section
  id="how"
  class="relative py-20 overflow-hidden bg-gradient-to-b from-slate-100 via-white to-blue-100 dark:from-neutral-950 dark:via-neutral-900 dark:to-neutral-950 transition-colors duration-200"
>
  <!-- BACKGROUND GLOWS -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute -top-40 left-0 w-[500px] h-[500px] bg-brand-blue-soft blur-[160px] rounded-full"
    >
    </div>
    <div
      class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-brand-blue-soft blur-[160px] rounded-full"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <!-- HEADER -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-blue-soft text-brand-blue text-sm font-bold uppercase tracking-[0.25em]"
      >
        How It Works
      </span>
      <h2
        class="text-4xl lg:text-4xl font-bold text-brand-ink mt-5 leading-tight"
      >
        Five steps
        <span class="block text-brand-blue">No theatre</span>
      </h2>

      <p class="text-lg text-brand-muted mt-6 leading-relaxed">
        Every step is designed to feel calm, simple, and supportive for parents.
      </p>
    </div>

    <!-- DESKTOP FLOW -->
    <div class="hidden lg:block relative">
      <!-- CONNECTING LINE -->
      <div
        class="absolute top-24 left-10 right-10 h-[2px] bg-gradient-to-r from-brand-blue-soft via-brand-blue to-brand-blue-soft"
      >
      </div>

      <div class="grid grid-cols-5 gap-8 relative items-stretch">
        {
          steps.map((item) => {
            const Icon = item.icon;

            return (
              <div class="relative group h-full">
                <!-- CARD -->
                <div class="h-full bg-surface/70 backdrop-blur-xl border border-brand-muted/20 hover:border-brand-blue/30 rounded-3xl p-6 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col text-center">
                  <!-- STEP NUMBER -->
                  <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-brand-blue text-white text-xs font-bold flex items-center justify-center shadow-md">
                    {item.step}
                  </div>

                  <!-- ICON -->
                  <div class="w-14 h-14 mx-auto mt-3 rounded-2xl bg-brand-blue-soft text-brand-blue flex items-center justify-center shrink-0">
                    <Icon size={26} />
                  </div>

                  <!-- TITLE -->
                  <div class="mt-5 min-h-[56px] flex items-center justify-center">
                    <h3 class="text-lg font-bold text-brand-ink leading-snug">
                      {item.title}
                    </h3>
                  </div>

                  <!-- DESCRIPTION -->
                  <div class="mt-2 flex-1">
                    <p class="text-sm text-brand-muted leading-relaxed min-h-[72px]">
                      {item.desc}
                    </p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- MOBILE (TIMELINE FLOW) -->
    <div class="lg:hidden space-y-6">
      {
        steps.map((item) => {
          const Icon = item.icon;

          return (
            <div class="flex gap-5 bg-surface/70 backdrop-blur-xl border border-brand-muted/20 rounded-3xl p-6 shadow-sm">
              <!-- LEFT ICON + LINE -->
              <div class="flex flex-col items-center">
                <div class="w-12 h-12 rounded-2xl bg-brand-blue-soft text-brand-blue flex items-center justify-center">
                  <Icon size={20} />
                </div>
                <div class="w-[2px] flex-1 bg-brand-blue-soft mt-3" />
              </div>

              <!-- CONTENT -->
              <div>
                <div class="text-xs font-bold text-brand-blue tracking-[0.2em] uppercase">
                  Step {item.step}
                </div>

                <h3 class="text-lg font-bold text-brand-ink mt-2">
                  {item.title}
                </h3>

                <p class="text-sm text-brand-muted mt-2 leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- CTA STRIP -->
    <div
      class="mt-20 bg-surface/70 backdrop-blur-xl border border-brand-muted/20 rounded-[2.5rem] p-10 shadow-xl hidden sm:flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 transition-colors duration-200"
    >
      <div class="max-w-2xl">
        <h3 class="text-2xl font-bold text-brand-ink mb-3">
          Built for clarity, not confusion.
        </h3>

        <p class="text-brand-muted text-lg leading-relaxed">
          No overwhelming reports. No jargon. Just calm, practical insights
          that help you understand your child better.
        </p>
      </div>

      <a
        href="#register"
        class="open-register-modal bg-brand-blue text-white px-8 py-4 rounded-2xl font-bold shadow-lg shadow-brand-blue/20 hover:scale-[1.03] transition duration-200"
      >
        Book Now
      </a>
    </div>
  </div>
</section>

