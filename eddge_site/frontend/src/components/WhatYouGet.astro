---
import { BarChart3, FileText, Lightbulb, Users } from "lucide-react";
import RegistrationForm from "./RegistrationForm.astro";

import strengthImg from "../assets/strength.png";
import environmentImg from "../assets/environment.png";
import lifeStageImg from "../assets/life_stage.png";
import expertImg from "../assets/expert_cource.png";

const deliverables = [
  {
    icon: BarChart3,
    title: "Strength Index",
    desc: "A map of what your child does naturally well, and where their wiring leans.",
    img: strengthImg.src,
  },
  {
    icon: FileText,
    title: "Environment Blueprint",
    desc: "The conditions where focus, curiosity and growth show up most.",
    img: environmentImg.src,
  },
  {
    icon: Lightbulb,
    title: "Growth Guidance",
    desc: "Direction that moves with your child, stage by stage.",
    img: lifeStageImg.src,
  },
  {
    icon: Users,
    title: "Expert Counseling",
    desc: "Time with people who have spent careers, in child development",
    img: expertImg.src,
  },
];
---

<div class="overflow-hidden">
  <!-- ================= WHAT YOU GET SECTION ================= -->
  <section
    id="what"
    class="relative py-28 overflow-hidden bg-surface scroll-mt-28 transition-colors duration-200"
  >
    <!-- GLOW BACKGROUND -->
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-[-200px] left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-brand-blue-soft blur-[160px] rounded-full"
      >
      </div>
      <div
        class="absolute bottom-[-150px] right-[-120px] w-[500px] h-[500px] bg-brand-blue-soft blur-[160px] rounded-full"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <!-- HEADER -->
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span
          class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-brand-blue-soft text-brand-blue text-sm font-bold uppercase tracking-[0.25em]"
        >
          What You Get
        </span>

        <h2
          class="mt-7 text-4xl md:text-5xl font-black leading-[1.05] text-brand-ink"
        >
          A clearer read on your child
          <span class="block text-brand-blue">And a plan that fits them</span>
        </h2>

        <p class="mt-6 text-lg text-brand-muted leading-relaxed">
          Four pieces of work that turn data into something you can actually use
          on any morning.
        </p>
      </div>

      <!-- CARDS -->
      <div class="grid md:grid-cols-2 gap-7">
        {
          deliverables.map((item) => {
            const Icon = item.icon;

            return (
              <div class="group relative rounded-[30px] border border-brand-muted/20 bg-surface shadow-sm hover:shadow-md p-7 transition-all duration-300 hover:-translate-y-1">
                <div class="relative z-10 flex gap-5">
                  <div class="w-14 h-14 rounded-2xl bg-brand-blue-soft flex items-center justify-center text-brand-blue shrink-0">
                    <Icon size={22} />
                  </div>

                  <div>
                    <h3 class="text-xl font-bold text-brand-ink">
                      {item.title}
                    </h3>

                    <p class="mt-2 text-sm text-brand-muted">{item.desc}</p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ================= REGISTER SECTION ================= -->
  <section
    id="register"
    class="relative py-28 bg-gradient-to-b from-surface to-slate-100 dark:to-neutral-950 scroll-mt-28 transition-colors duration-200"
  >
    <div class="max-w-6xl mx-auto px-6">
      <!-- ATTACHED CONTAINER -->
      <div
        class="grid lg:grid-cols-2 gap-0 items-stretch rounded-[40px] overflow-hidden border border-brand-muted/20 shadow-lg"
      >
        <!-- ================= LEFT PANEL ================= -->
        <div class="relative bg-brand-blue p-12 md:p-14 text-white">
          <!-- subtle glow -->
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.25),transparent)]"
          >
          </div>

          <div class="relative z-10">
            <h2 class="text-4xl md:text-5xl font-bold leading-tight">
              Get on the <span class="text-neutral-950">list</span>
            </h2>

            <p class="mt-5 text-white/80 text-lg leading-relaxed">
              Early access to Eddge, including the report, the expert sessions,
              and the parent community that has been quietly building this with
              us.
            </p>

            <div class="mt-10 space-y-4 text-sm text-white/90">
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-white"></span>
                A deep developmental profile of your child
              </div>

              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-white"></span>
                Recommendations from practitioners with 20+ years on the ground
              </div>

              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-white"></span>
                First access, founder pricing, and a seat at our parent circles
              </div>
            </div>

            <div
              class="mt-10 p-5 rounded-2xl bg-black/10 border border-white/10 backdrop-blur-sm"
            >
              <p class="italic text-white/90">
                “Two decades in this work taught us one thing: every child is
                already an answer. The job is to learn the question”
              </p>
            </div>
          </div>
        </div>

        <!-- ================= RIGHT PANEL (FORM) ================= -->
        <div class="bg-surface p-10 lg:p-12 transition-colors duration-200">
          <!-- HEADER -->
          <span
            class="text-brand-blue uppercase tracking-[0.25em] text-xs font-semibold"
          >
            Get Started
          </span>

          <h3 class="mt-4 text-4xl font-bold text-brand-ink leading-tight">
            Create your profile
          </h3>

          <p class="mt-3 text-brand-muted mb-10">
            Sixty seconds to join. We'll take it from there
          </p>

          <!-- FORM -->
          <RegistrationForm />
        </div>
      </div>
    </div>
  </section>
</div>

<!-- ================= DYNAMIC FORM INPUT STYLING ================= -->
<style is:global>
  .input-light {
    width: 100%;
    padding: 16px 18px;
    border-radius: 14px;
    border: 1px solid rgba(var(--raw-brand-muted), 0.2);
    background: var(--raw-paper);
    color: var(--raw-brand-ink);
    outline: none;
    transition: all 0.2s ease;
    font-size: 0.95rem;
  }

  /* Specific placeholder color for light and dark modes */
  .input-light::placeholder {
    color: var(--raw-brand-muted);
    opacity: 0.6;
  }

  .input-light:focus {
    border-color: var(--raw-brand-blue);
    box-shadow: 0 0 0 4px var(--raw-brand-blue-soft);
    background: var(--raw-surface);
  }
</style>
