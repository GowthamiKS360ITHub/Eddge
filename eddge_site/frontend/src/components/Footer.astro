---
import { Mail, Phone, MapPin } from "lucide-react";

import logoUrl from "../assets/eddge-mark.png?url";
---

<footer
  class="bg-gradient-to-b from-slate-100 via-white to-blue-100 dark:from-neutral-950 dark:via-neutral-900 dark:to-neutral-950 border-t border-brand-muted/10 transition-colors duration-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12 pb-8 text-center md:text-left"
    >
      <!-- BRAND -->
      <div class="lg:col-span-1">
        <div
          class="mb-4 flex items-center justify-center md:justify-start gap-3"
        >
          <img src={logoUrl} alt="EDDGE Logo" class="h-16 object-contain" />
          <div class="flex flex-col">
            <span class="text-2xl font-black text-brand-blue tracking-wide"
              >EDDGE</span
            >
            <span
              class="text-[10px] font-bold text-brand-ink tracking-widest mt-[-2px] opacity-80"
              >SEE BEYOND. GUIDE BETTER.</span
            >
          </div>
        </div>
        <p class="text-[13px] text-brand-muted leading-relaxed mb-6">
          EDDGE helps you understand your child better through DNA science and
          expert guidance.
        </p>
        <div class="flex justify-center md:justify-start gap-3">
          <a
            href="https://facebook.com/"
            target="_blank"
            class="w-7 h-7 rounded-full bg-brand-blue text-white flex items-center justify-center hover:bg-opacity-90 transition-all"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="none"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </a>
          <a
            href="https://instagram.com/"
            target="_blank"
            class="w-7 h-7 rounded-full bg-brand-blue text-white flex items-center justify-center hover:bg-opacity-90 transition-all"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://linkedin.com/"
            target="_blank"
            class="w-7 h-7 rounded-full bg-brand-blue text-white flex items-center justify-center hover:bg-opacity-90 transition-all"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="none"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        </div>
      </div>

      <!-- COMPANY -->
      <div>
        <h4 class="text-[14px] font-bold text-brand-ink mb-5">Company</h4>
        <ul class="space-y-3">
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >About Us</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Our Science</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Our Experts</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Careers</a
            >
          </li>
        </ul>
      </div>

      <!-- RESOURCES -->
      <div>
        <h4 class="text-[14px] font-bold text-brand-ink mb-5">Resources</h4>
        <ul class="space-y-3">
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Blog</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Parent Guide</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Glossary</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Help Center</a
            >
          </li>
        </ul>
      </div>

      <!-- SUPPORT -->
      <div>
        <h4 class="text-[14px] font-bold text-brand-ink mb-5">Support</h4>
        <ul class="space-y-3">
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >FAQs</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Contact Us</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Terms & Conditions</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-[13px] text-brand-muted hover:text-brand-blue transition-colors"
              >Privacy Policy</a
            >
          </li>
        </ul>
      </div>

      <!-- CONTACT -->
      <div>
        <h4 class="text-[14px] font-bold text-brand-ink mb-5">Contact Us</h4>
        <div class="space-y-4">
          <div
            class="flex items-center justify-center md:justify-start gap-3 text-[13px] text-brand-muted"
          >
            <Phone size={16} className="text-brand-blue" />
            <span>+91 XXXXXXXXXX</span>
          </div>
          <div
            class="flex items-center justify-center md:justify-start gap-3 text-[13px] text-brand-muted"
          >
            <Mail size={16} className="text-brand-blue" />
            <span>hello@eddge.in</span>
          </div>
          <div
            class="flex items-center justify-center md:justify-start gap-3 text-[13px] text-brand-muted"
          >
            <MapPin size={16} className="text-brand-blue" />
            <span>Bangalore, India</span>
          </div>
        </div>
      </div>
    </div>

    <!-- BOTTOM -->
    <div class="pt-4 flex justify-center border-t border-brand-muted/10">
      <p class="text-[13px] text-brand-muted opacity-80">
        © 2026 EDDGE. All rights reserved.
      </p>
    </div>
  </div>
</footer>
