---
import {
  Dna,
  Lock,
  Users,
  Microscope,
  Sparkles,
  ArrowRight,
  Play,
} from "lucide-react";

import indian_family from "../assets/indian_family.png";

const heroImgSrc =
  typeof indian_family === "string"
    ? indian_family
    : (indian_family?.src ?? "");

const features = [
  { icon: Dna, label: "Rooted in science" },
  { icon: Lock, label: "Held in confidence" },
  { icon: Users, label: "Led by counsellors" },
  { icon: Microscope, label: "Backed by 20+ years of practice" },
];
---

<section
  class="relative overflow-hidden bg-gradient-to-b from-[color:var(--hero-bg-start)] via-[color:var(--hero-bg-mid)] to-[color:var(--hero-bg-end)] transition-colors duration-200"
>
  <!-- SOFT BACKGROUNDS -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-[color:var(--color-brand-blue-soft)] blur-[160px] rounded-full"
    >
    </div>
    <div
      class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-[color:var(--color-brand-blue-soft)] blur-[160px] rounded-full"
    >
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8 pt-5 pb-24">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- LEFT -->
      <div>
        <!-- BADGE -->
        <div
          class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full dark:border-neutral-800 shadow-sm text-[color:var(--color-brand-ink)] dark:text-[color:var(--color-brand-ink)] dark:bg-[color:var(--color-surface)] text-sm font-medium transition-colors"
        >
          <div
            class="flex items-center justify-center w-6 h-6 rounded-full bg-[color:var(--color-brand-blue-soft)]"
          >
            <Sparkles
              size={14}
              className="text-[color:var(--color-brand-blue)]"
            />
          </div>
          Science-backed developmental insights
        </div>

        <!-- TITLE -->
        <h1
          class="mt-6 text-4xl lg:text-5xl font-black leading-[1.05] text-[color:var(--color-brand-ink)]"
        >
          You see 10%
          <br />
          The rest is your child's
          <span class="text-[color:var(--color-brand-blue)]">real story.</span>
        </h1>

        <!-- SUBTEXT -->
        <p
          class="mt-6 text-lg text-[color:var(--color-brand-muted)] dark:text-[color:var(--color-brand-muted)] max-w-xl leading-relaxed transition-colors"
        >
          EDDGE uses DNA insights to scientifically map a child's core
          competencies, uncovering hidden strengths and helping parents create
          the right environment for their child to bloom.
        </p>

        <!-- TRUST FEATURES -->
        <div
          class="mt-12 grid grid-cols-2 gap-4 sm:flex sm:flex-wrap sm:gap-6 text-slate-500 dark:text-slate-400 text-sm transition-colors"
        >
          {
            features.map((item) => {
              const Icon = item.icon;

              return (
                <div class="flex items-center gap-2">
                  <Icon
                    size={18}
                    className="text-[color:var(--color-brand-blue)] shrink-0"
                  />
                  <span class="leading-tight">{item.label}</span>
                </div>
              );
            })
          }
        </div>

        <!-- CTA BUTTONS -->
        <div class="mt-10 flex flex-row gap-3 sm:gap-4">
          <a
            href="#"
            class="open-register-modal group bg-[color:var(--color-brand-blue)] text-white px-4 py-3 sm:px-8 sm:py-4 rounded-2xl font-bold text-sm sm:text-lg shadow-xl shadow-[color:var(--color-brand-blue-soft)] hover:scale-[1.02] active:scale-95 transition flex items-center justify-center gap-2 sm:gap-3 flex-1 sm:flex-none whitespace-nowrap"
          >
            Book Now
            <ArrowRight
              className="group-hover:translate-x-1 transition w-4 h-4 sm:w-5 sm:h-5"
            />
          </a>

          <a
            href="#videosection"
            class="flex items-center justify-center gap-2 sm:gap-3 px-4 py-3 sm:px-8 sm:py-4 rounded-2xl bg-[color:var(--color-surface)] shadow-sm hover:shadow-md transition text-[color:var(--color-brand-ink)] border border-[color:var(--color-brand-blue-soft)] font-semibold text-sm sm:text-base flex-1 sm:flex-none whitespace-nowrap"
          >
            <div
              class="w-7 h-7 sm:w-10 sm:h-10 shrink-0 rounded-full bg-[color:var(--color-brand-blue)] flex items-center justify-center text-[color:var(--color-surface)]"
            >
              <Play
                fill="currentColor"
                className="text-white w-3 h-3 sm:w-4 sm:h-4"
              />
            </div>
            How it works
          </a>
        </div>
      </div>

      <!-- RIGHT (IMAGE) -->
      <div class="relative hidden lg:block">
        <div
          class="rounded-[2.5rem] overflow-hidden shadow-2xl dark:shadow-black/50 border border-slate-200/20 dark:border-neutral-800/50 transform hover:scale-[1.02] transition duration-500"
        >
          <img
            src={heroImgSrc}
            class="w-full h-[520px] object-cover"
            alt="Parent and child"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  :root {
    --hero-bg-start: #f1f5f9; /* Slate 100 */
    --hero-bg-mid: #ffffff; /* White */
    --hero-bg-end: #dbeafe; /* Blue 100 */
  }

  html.dark {
    --hero-bg-start: #090d16; /* Deep dark blue-grey */
    --hero-bg-mid: #121214; /* Dark grey */
    --hero-bg-end: #0d1527; /* Slate 950 transition shade */
  }
</style>
