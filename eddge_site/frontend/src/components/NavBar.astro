---
import logoUrl from "../assets/eddge-mark.png?url";
import { Menu, ArrowRight } from "lucide-react";
import ThemeToggle from "./ThemeToggle.astro";
---

<nav
  class="sticky top-0 z-50 bg-[color:var(--color-surface)]/80 backdrop-blur-xl border-b border-[color:var(--color-brand-muted)]/20 transition-colors duration-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- LOGO -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img src={logoUrl} alt="EDDGE Logo" class="w-12 h-12 object-contain" />
        <div class="flex flex-col">
          <span
            class="text-2xl font-black text-[color:var(--color-brand-blue)] tracking-tight leading-none"
          >
            EDDGE
          </span>
          <!-- <span
            class="text-[10px] font-bold text-[color:var(--color-brand-ink)] tracking-[0.15em] mt-1 opacity-80"
          >
            SEE BEYOND. GUIDE BETTER.
          </span> -->
        </div>
      </a>

      <!-- RIGHT WING (MENU + CTA) -->
      <div class="flex items-center gap-8">
        <!-- DESKTOP MENU -->
        <div class="hidden md:flex items-center gap-10">
          <a
            href="#why"
            class="nav-item text-sm font-bold text-[color:var(--color-brand-muted)] hover:text-[color:var(--color-brand-blue)] transition-colors"
          >
            Why EDDGE
          </a>

          <a
            href="#how"
            class="nav-item text-sm font-bold text-[color:var(--color-brand-muted)] hover:text-[color:var(--color-brand-blue)] transition-colors"
          >
            How It Works
          </a>

          <a
            href="#what"
            class="nav-item text-sm font-bold text-[color:var(--color-brand-muted)] hover:text-[color:var(--color-brand-blue)] transition-colors"
          >
            What Users Get
          </a>
        </div>

        <!-- RIGHT ACTIONS -->
        <div class="flex items-center gap-4">
          <!-- THEME TOGGLE -->
          <ThemeToggle />

          <!-- CTA -->
          <a
            href="#"
            data-title="Join Waitlist"
            class="open-register-modal hidden sm:flex items-center gap-2 px-6 py-3 rounded-full bg-[color:var(--color-brand-blue)] text-white text-sm font-bold hover:scale-[1.02] active:scale-95 transition-all shadow-lg shadow-[color:var(--color-brand-blue)]/20"
          >
            Join Waitlist
          </a>

          <!-- MOBILE MENU BUTTON -->
          <button
            id="menuBtn"
            class="md:hidden w-11 h-11 rounded-xl border border-[color:var(--color-brand-muted)]/30 flex items-center justify-center bg-[color:var(--color-surface)] text-[color:var(--color-brand-ink)]"
          >
            <Menu size={20} />
          </button>
        </div>
      </div>
    </div>

    <!-- MOBILE MENU -->
    <div id="mobileMenu" class="hidden md:hidden pb-6">
      <div
        class="bg-[color:var(--color-surface)] border border-[color:var(--color-brand-muted)]/20 rounded-3xl p-6 shadow-xl space-y-5"
      >
        <a
          href="#why"
          class="nav-item mobile-link block text-base font-bold text-[color:var(--color-brand-ink)] hover:text-[color:var(--color-brand-blue)] transition-colors"
        >
          Why EDDGE
        </a>

        <a
          href="#how"
          class="nav-item mobile-link block text-base font-bold text-[color:var(--color-brand-ink)] hover:text-[color:var(--color-brand-blue)] transition-colors"
        >
          How It Works
        </a>

        <a
          href="#what"
          class="nav-item mobile-link block text-base font-bold text-[color:var(--color-brand-ink)] hover:text-[color:var(--color-brand-blue)] transition-colors"
        >
          What Users Get
        </a>

        <!-- MOBILE CTA -->
        <a
          href="#"
          data-title="Join Waitlist"
          class="open-register-modal flex items-center justify-center gap-2 w-full mt-2 bg-[color:var(--color-brand-blue)] text-white py-3 rounded-full font-bold"
        >
          Join Waitlist
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");

  const mobileLinks = document.querySelectorAll(".mobile-link");
  const navItems = document.querySelectorAll(".nav-item");

  // MOBILE MENU TOGGLE
  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });

  // CLOSE MOBILE MENU ON LINK CLICK
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
    });
  });

  // ACTIVE LINK HIGHLIGHTING ON SCROLL
  function updateActiveLink() {
    let current = "";
    const sections = document.querySelectorAll("section[id]");

    sections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      if (rect.top <= window.innerHeight / 3) {
        current = section.getAttribute("id") || "";
      }
    });

    navItems.forEach((link) => {
      // Clean active styling states
      link.classList.remove(
        "text-[color:var(--color-brand-blue)]",
        "underline",
        "underline-offset-8",
        "decoration-2",
      );

      // Default classes based on item type
      if (link.classList.contains("mobile-link")) {
        link.classList.add("text-[color:var(--color-brand-ink)]");
        link.classList.remove("text-[color:var(--color-brand-muted)]");
      } else {
        link.classList.add("text-[color:var(--color-brand-muted)]");
        link.classList.remove("text-[color:var(--color-brand-ink)]");
      }

      // Apply dynamic active classes
      if (current && link.getAttribute("href") === `#${current}`) {
        link.classList.add(
          "text-[color:var(--color-brand-blue)]",
          "underline",
          "underline-offset-8",
          "decoration-2",
        );
        link.classList.remove(
          "text-[color:var(--color-brand-muted)]",
          "text-[color:var(--color-brand-ink)]",
        );
      }
    });
  }

  window.addEventListener("scroll", updateActiveLink);
  // Initial check
  updateActiveLink();
</script>
