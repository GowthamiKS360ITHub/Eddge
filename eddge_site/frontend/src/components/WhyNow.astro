---
import {
  Sparkles,
  Compass,
  Brain,
  HeartHandshake,
  CheckCircle2,
} from "lucide-react";

const features = [
  {
    icon: Brain,
    title: "Read the strengths",
    desc: "Know what naturally fits your child.",
  },
  {
    icon: Compass,
    title: "Decide with conviction",
    desc: "Make better developmental decisions.",
  },
  {
    icon: Sparkles,
    title: "Spot the potential",
    desc: "Identify hidden abilities early.",
  },
  {
    icon: HeartHandshake,
    title: "Sit with experts",
    desc: "Receive calm and practical guidance.",
  },
];

const insights = [
  "Natural strengths and inclinations, mapped",
  "The environments where your child sharpens",
  "Confidence at every fork in the road",
  "Guidance built for parents, not professionals",
];
---

<section
  id="why"
  class="relative py-20 bg-surface overflow-hidden transition-colors duration-200"
>
  <!-- Soft Dynamic Background -->
  <div
    class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_top_right,var(--raw-brand-blue-soft),transparent_30%)]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- TOP -->
    <div class="grid lg:grid-cols-2 gap-16 items-center mb-16">
      <!-- LEFT CONTENT -->
      <div
        class="flex flex-col items-center text-center lg:items-start lg:text-left"
      >
        <span
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-blue-soft text-brand-blue text-sm font-bold uppercase tracking-[0.25em]"
        >
          WHY EDDGE
        </span>

        <h2
          class="mt-6 text-3xl lg:text-4xl font-black leading-tight text-brand-ink"
        >
          Parenting on instinct is hard
          <span class="text-brand-blue block mt-2"
            >It doesn't have to be lonely</span
          >
        </h2>

        <p
          class="mt-7 text-lg lg:text-xl leading-relaxed text-brand-muted max-w-xl transition-colors"
        >
          Eddge brings together DNA science, child-development expertise, and
          the wisdom of parent community across India, so the calls you make for
          your child are made with company, and with evidence.
        </p>

        <!-- FEATURE STRIP -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-10 w-fit">
          {
            features.map((item) => {
              const Icon = item.icon;

              return (
                <div class="flex items-center gap-3 bg-surface/60 hover:bg-surface border border-brand-muted/20 hover:border-brand-muted/40 rounded-full py-2.5 px-5 shadow-sm hover:shadow-md transition-all duration-300">
                  <div class="bg-brand-blue-soft rounded-full p-1.5 transition-transform duration-300">
                    <Icon size={20} className="text-brand-blue" />
                  </div>
                  <span class="text-sm font-medium text-brand-ink">
                    {item.title}
                  </span>
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- RIGHT IMAGE -->
      <div class="relative hidden sm:block">
        <!-- Main Image -->
        <div
          class="rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.08)] dark:shadow-[0_30px_80px_rgba(0,0,0,0.5)] border border-brand-muted/10"
        >
          <img
            src="https://images.openai.com/static-rsc-4/_VAhBfHOTdX2jXx9ISpHuYV3fNZlAqY2nsQi1LCV3oXglGbZjbn9085i5VkzpeQMmrFc9Vt5CmQbvsFnD5kKGu0-ImpRh4ZzLQOI-U7G0l64Sdekwc6PrvvOtrRyKmZOdHvoYsZtr7VND4Pc1-gumfVlaG6_KvaBcrYGm_vkLfo?purpose=inline"
            alt="Parent and child"
            class="w-full h-[560px] object-cover"
          />
        </div>

        <!-- FLOAT CARD -->
        <div
          class="absolute bottom-6 left-6 right-6 bg-surface/95 backdrop-blur-md rounded-3xl p-6 shadow-[0_20px_40px_rgba(0,0,0,0.06)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.4)] border border-brand-muted/20 transition-all duration-200"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              insights.map((item) => (
                <div class="flex items-center gap-3">
                  <CheckCircle2
                    size={20}
                    className="text-brand-blue shrink-0"
                  />
                  <span class="text-sm text-brand-ink/80 font-medium transition-colors">
                    {item}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
