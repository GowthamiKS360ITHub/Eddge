---
import {
  Sparkles,
  Compass,
  Brain,
  HeartHandshake,
  CheckCircle2,
} from "lucide-react";

const features = [
  {
    icon: Brain,
    title: "Understand strengths",
    desc: "Know what naturally fits your child.",
  },
  {
    icon: Compass,
    title: "Choose confidently",
    desc: "Make better developmental decisions.",
  },
  {
    icon: Sparkles,
    title: "Discover potential",
    desc: "Identify hidden abilities early.",
  },
  {
    icon: HeartHandshake,
    title: "Guided by experts",
    desc: "Receive calm and practical guidance.",
  },
];

const insights = [
  "Natural strengths & tendencies",
  "Right learning environment",
  "Confidence in key decisions",
  "Guidance designed for parents",
];
---

<section
  id="why"
  class="relative py-20 bg-[color:var(--color-surface)] overflow-hidden"
>
  <!-- Soft Background -->
  <div
    class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_top_right,var(--color-brand-blue-soft),transparent_30%)]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- TOP -->
    <div class="grid lg:grid-cols-2 gap-16 items-center mb-16">
      <!-- LEFT CONTENT -->
      <div>
        <span
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[color:var(--color-brand-blue-soft)] text-[color:var(--color-brand-blue)] text-sm font-bold uppercase tracking-[0.25em]"
        >
          WHY EDDGE
        </span>

        <h2
          class="mt-6 text-4xl lg:text-5xl font-black leading-tight text-[color:var(--color-brand-ink)]"
        >
          Understand your child

          <span class="text-[color:var(--color-brand-blue)] block mt-2">
            beyond assumptions.
          </span>
        </h2>

        <p
          class="mt-7 text-lg lg:text-xl leading-relaxed text-slate-600 max-w-xl"
        >
          EDDGE combines science-backed insights and expert guidance to help
          parents make more confident decisions for their child.
        </p>

        <!-- FEATURE STRIP -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-10 w-fit">
          {
            features.map((item) => {
              const Icon = item.icon;

              return (
                <div class="flex items-center gap-3 bg-white/60 hover:bg-white border border-slate-200/60 hover:border-slate-200 rounded-full py-2.5 px-5 shadow-sm hover:shadow-md transition-all duration-300">
                  <div class="bg-[color:var(--color-brand-blue-soft)] rounded-full p-1.5 group-hover:scale-110 transition-transform duration-300">
                    <Icon
                      size={20}
                      className="text-[color:var(--color-brand-blue)]"
                    />
                  </div>
                  <span class="text-sm font-medium text-[color:var(--color-brand-ink)]">
                    {item.title}
                  </span>
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- RIGHT IMAGE -->
      <div class="relative">
        <!-- Main Image -->
        <div
          class="rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.08)]"
        >
          <img
            src="https://images.openai.com/static-rsc-4/_VAhBfHOTdX2jXx9ISpHuYV3fNZlAqY2nsQi1LCV3oXglGbZjbn9085i5VkzpeQMmrFc9Vt5CmQbvsFnD5kKGu0-ImpRh4ZzLQOI-U7G0l64Sdekwc6PrvvOtrRyKmZOdHvoYsZtr7VND4Pc1-gumfVlaG6_KvaBcrYGm_vkLfo?purpose=inline"
            alt="Parent and child"
            class="w-full h-[560px] object-cover"
          />
        </div>

        <!-- FLOAT CARD -->
        <div
          class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md rounded-3xl p-6 shadow-[0_20px_40px_rgba(0,0,0,0.06)] border border-white/50"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              insights.map((item) => (
                <div class="flex items-center gap-3">
                  <CheckCircle2
                    size={20}
                    className="text-[color:var(--color-brand-blue)] shrink-0"
                  />
                  <span class="text-sm text-slate-700 font-medium">{item}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
