---
// src/components/ThemeToggle.astro
---

<button
  aria-label="Toggle dark mode"
  class="theme-toggle p-2 rounded-lg transition-colors duration-200 hover:bg-neutral-200 dark:hover:bg-neutral-800 text-[color:var(--color-brand-ink)] focus:outline-none"
>
  <!-- Sun Icon (visible in Dark Mode) -->
  <svg
    class="theme-toggle-light-icon hidden w-5 h-5"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"
    ></path>
  </svg>

  <!-- Moon Icon (visible in Light Mode) -->
  <svg
    class="theme-toggle-dark-icon hidden w-5 h-5"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    ></path>
  </svg>
</button>

<script>
  const setupToggle = () => {
    const themeToggles = document.querySelectorAll('.theme-toggle');

    if (!themeToggles.length) return;

    const updateIcons = () => {
      const isDark = document.documentElement.classList.contains('dark');
      themeToggles.forEach(btn => {
        const lightIcon = btn.querySelector('.theme-toggle-light-icon');
        const darkIcon = btn.querySelector('.theme-toggle-dark-icon');
        if (isDark) {
          lightIcon?.classList.remove('hidden');
          darkIcon?.classList.add('hidden');
        } else {
          lightIcon?.classList.add('hidden');
          darkIcon?.classList.remove('hidden');
        }
      });
    };

    // Set initial icon state based on root class
    updateIcons();

    // Toggle logic
    themeToggles.forEach(btn => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });
    });
  };

  // Run on initial load
  setupToggle();

  // Support Astro View Transitions if you opt to use them later
  document.addEventListener('astro:after-swap', setupToggle);
</script>