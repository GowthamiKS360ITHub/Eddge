---
import { Play, ArrowRight } from "lucide-react";
import eddgeVideoSrc from "../assets/eddge-video.mp4";
import thumbnail from "../assets/thumbnail.png";
---

<section
  id="videosection"
  class="relative py-12 md:py-16 overflow-hidden bg-white"
>
  <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 relative z-10">
    <!-- MAIN COMPACT CARD -->
    <div
      class="relative rounded-[2rem] md:rounded-[2.5rem] overflow-hidden bg-[#FAFBFF] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 flex flex-col md:flex-row items-center md:items-stretch min-h-[180px] md:h-[220px]"
    >
      <!-- BACKGROUND DECORATION (Right side DNA) -->
      <div
        class="absolute right-0 top-0 bottom-0 w-1/2 md:w-[55%] pointer-events-none overflow-hidden flex items-center justify-end z-0"
      >
        <svg
          class="w-full min-w-[500px] text-[var(--color-brand-blue)] opacity-[0.06] translate-x-12 md:translate-x-4"
          viewBox="0 0 800 300"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <g transform="translate(0, 0)">
            <!-- DNA Strand 1 -->
            <path
              d="M -50 150 Q 100 30 200 150 T 450 150 T 700 150 T 950 150"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
            <!-- DNA Strand 2 -->
            <path
              d="M -50 150 Q 100 270 200 150 T 450 150 T 700 150 T 950 150"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>

            <!-- Rungs -->
            <g stroke="currentColor" stroke-width="1.5">
              <line x1="30" y1="131" x2="30" y2="169"></line>
              <line x1="60" y1="108" x2="60" y2="192"></line>
              <line x1="90" y1="92" x2="90" y2="208"></line>
              <line x1="120" y1="92" x2="120" y2="208"></line>
              <line x1="150" y1="108" x2="150" y2="192"></line>
              <line x1="180" y1="131" x2="180" y2="169"></line>

              <line x1="230" y1="169" x2="230" y2="131"></line>
              <line x1="260" y1="192" x2="260" y2="108"></line>
              <line x1="290" y1="208" x2="290" y2="92"></line>
              <line x1="320" y1="208" x2="320" y2="92"></line>
              <line x1="350" y1="192" x2="350" y2="108"></line>
              <line x1="380" y1="169" x2="380" y2="131"></line>

              <line x1="430" y1="131" x2="430" y2="169"></line>
              <line x1="460" y1="108" x2="460" y2="192"></line>
              <line x1="490" y1="92" x2="490" y2="208"></line>
              <line x1="520" y1="92" x2="520" y2="208"></line>
              <line x1="550" y1="108" x2="550" y2="192"></line>
              <line x1="580" y1="131" x2="580" y2="169"></line>

              <line x1="630" y1="169" x2="630" y2="131"></line>
              <line x1="660" y1="192" x2="660" y2="108"></line>
              <line x1="690" y1="208" x2="690" y2="92"></line>
              <line x1="720" y1="208" x2="720" y2="92"></line>
              <line x1="750" y1="192" x2="750" y2="108"></line>
              <line x1="780" y1="169" x2="780" y2="131"></line>
            </g>
            <!-- Dots at intersections -->
            <g fill="currentColor">
              <circle cx="200" cy="150" r="3.5"></circle>
              <circle cx="450" cy="150" r="3.5"></circle>
              <circle cx="700" cy="150" r="3.5"></circle>
            </g>
          </g>
        </svg>
      </div>

      <!-- LEFT: VIDEO THUMBNAIL -->
      <div
        class="p-3 md:p-4 w-full md:w-auto shrink-0 relative z-10 flex items-center justify-center"
      >
        <div
          class="relative w-full md:w-[280px] lg:w-[320px] aspect-[16/9] md:aspect-auto md:h-full rounded-[1.5rem] md:rounded-[2rem] overflow-hidden group shadow-sm bg-white"
        >
          <video
            id="eddgeVideo"
            class="w-full h-full object-cover"
            poster={thumbnail.src}
            playsinline
          >
            <source src={eddgeVideoSrc} type="video/mp4" />
          </video>

          <!-- PLAY OVERLAY -->
          <div
            id="videoOverlay"
            class="absolute inset-0 flex items-center justify-center z-20 bg-black/5 group-hover:bg-black/10 transition-colors duration-300 cursor-pointer"
          >
            <button
              id="playBtn"
              class="relative w-14 h-14 rounded-full bg-[var(--color-brand-blue)] text-white shadow-lg flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <Play
                size={22}
                fill="currentColor"
                className="ml-1 relative z-10"
              />
            </button>
          </div>
        </div>
      </div>

      <!-- CENTER: TEXT CONTENT -->
      <div
        class="flex-1 p-6 md:p-8 md:pl-6 flex flex-col justify-center relative z-10 text-center md:text-left"
      >
        <p
          class="text-[var(--color-brand-blue)] text-xs font-bold uppercase tracking-[0.1em] mb-2"
        >
          SEE HOW EDDGE WORKS
        </p>

        <h3
          class="text-2xl md:text-3xl font-bold text-[#0f172a] mb-1.5 leading-tight tracking-tight"
        >
          Watch our 60 sec video
        </h3>

        <p
          class="text-[15px] md:text-base text-slate-600 mb-5 md:mb-6 font-medium"
        >
          to understand the EDDGE journey.
        </p>

        <div>
          <button
            id="inlinePlayBtn"
            class="inline-flex items-center gap-1.5 text-[var(--color-brand-blue)] font-semibold hover:gap-2.5 transition-all duration-300 group text-[15px]"
          >
            Play Video <ArrowRight size={18} className="transition-transform" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById("eddgeVideo");
  const playBtn = document.getElementById("playBtn");
  const inlinePlayBtn = document.getElementById("inlinePlayBtn");
  const overlay = document.getElementById("videoOverlay");

  const togglePlay = () => {
    if (video instanceof HTMLVideoElement) {
      if (video.paused) {
        video.play();
      } else {
        video.pause();
      }
    }
  };

  playBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    togglePlay();
  });

  overlay?.addEventListener("click", togglePlay);

  inlinePlayBtn?.addEventListener("click", togglePlay);

  if (video instanceof HTMLVideoElement) {
    video.addEventListener("play", () => {
      if (overlay instanceof HTMLElement) {
        overlay.style.opacity = "0";
        overlay.style.pointerEvents = "none";
      }
    });

    video.addEventListener("pause", () => {
      if (overlay instanceof HTMLElement) {
        overlay.style.opacity = "1";
        overlay.style.pointerEvents = "auto";
      }
    });

    video.addEventListener("ended", () => {
      if (overlay instanceof HTMLElement) {
        overlay.style.opacity = "1";
        overlay.style.pointerEvents = "auto";
      }
    });
  }
</script>
