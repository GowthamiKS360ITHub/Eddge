---
import { Play } from "lucide-react";
---

<section id="videosection" class="relative py-24 overflow-hidden bg-gradient-to-b from-slate-50 via-white to-blue-50">

  <!-- BACKGROUND GLOWS -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-[#248AC3]/10 blur-[140px] rounded-full"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-indigo-200/20 blur-[140px] rounded-full"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- HEADER -->
    <div class="text-center max-w-3xl mx-auto mb-16">

      <span
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#248AC3]/10 text-[#248AC3] text-sm font-bold uppercase tracking-[0.25em]"
        >
         Watch EDDGE
        </span>

      <h2 class="text-4xl lg:text-5xl font-bold text-slate-900 mt-5 leading-tight">
        See how EDDGE works
      </h2>

      <p class="text-lg text-slate-600 mt-6 leading-relaxed">
        A calm, science-backed approach to understanding your child better.
      </p>

    </div>

    <!-- MAIN CARD -->
    <div class="relative rounded-[2.8rem] overflow-hidden border border-white/60 bg-white/60 backdrop-blur-2xl shadow-2xl">

      <div class="grid lg:grid-cols-2">

        <!-- VIDEO SIDE -->
        <div class="relative min-h-[320px] lg:min-h-[520px] group">

          <!-- cinematic frame -->
          <div class="absolute inset-0 bg-gradient-to-tr from-black/20 via-transparent to-black/10 z-10"></div>

          <video
            id="eddgeVideo"
            class="w-full h-full object-cover scale-[1.02] group-hover:scale-[1.05] transition-transform duration-700"
            poster="https://images.unsplash.com/photo-1516627145497-ae6968895b74?q=80&w=1600&auto=format&fit=crop"
          >
            <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4" />
          </video>

          <!-- PLAY OVERLAY -->
          <div
            id="videoOverlay"
            class="absolute inset-0 flex items-center justify-center z-20 bg-black/10 backdrop-blur-sm transition-opacity duration-300"
          >
            <button
              id="playBtn"
              class="relative w-24 h-24 rounded-full bg-white text-[#248AC3] shadow-2xl flex items-center justify-center hover:scale-110 transition-all"
            >
              <!-- pulsing ring -->
              <span class="absolute inset-0 rounded-full animate-ping bg-white/40"></span>

              <Play size={34} fill="currentColor" className="ml-1 relative z-10" />
            </button>
          </div>

        </div>

        <!-- CONTENT SIDE -->
        <div class="p-10 lg:p-14 bg-white/40 backdrop-blur-xl">

          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#248AC3]/10 text-[#248AC3] text-sm font-semibold mb-6">
            60 Second Overview
          </div>

          <h3 class="text-3xl lg:text-4xl font-bold text-slate-900 leading-tight mb-6">
            Understanding your child shouldn’t feel like guessing.
          </h3>

          <p class="text-lg leading-relaxed text-slate-600 mb-8">
            EDDGE combines science, human insight, and expert guidance
            to help parents make more confident decisions for their child’s growth.
          </p>

          <!-- FEATURES -->
          <div class="space-y-5 mb-10">

            <div class="flex items-start gap-4">
              <div class="w-3 h-3 rounded-full bg-[#248AC3] mt-2"></div>
              <p class="text-slate-700">Simple and parent-friendly DNA insights</p>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-3 h-3 rounded-full bg-[#248AC3] mt-2"></div>
              <p class="text-slate-700">Expert-backed developmental guidance</p>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-3 h-3 rounded-full bg-[#248AC3] mt-2"></div>
              <p class="text-slate-700">Personalized clarity for every stage of growth</p>
            </div>

          </div>

          <!-- CTA -->
          <a
            href="#register"
            class="open-register-modal inline-flex items-center justify-center bg-[#248AC3] text-white px-8 py-4 rounded-full font-bold text-lg hover:scale-[1.03] transition-all shadow-lg shadow-[#248AC3]/20"
          >
            Book Now
          </a>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const video = document.getElementById("eddgeVideo");
  const playBtn = document.getElementById("playBtn");
  const overlay = document.getElementById("videoOverlay");

  playBtn?.addEventListener("click", () => {
    if (video instanceof HTMLVideoElement) {
      video.play();
    }
    if (overlay instanceof HTMLElement) {
      overlay.style.opacity = "0";
      overlay.style.pointerEvents = "none";
    }
  });

  if (video instanceof HTMLVideoElement) {
    video.addEventListener("pause", () => {
      if (overlay instanceof HTMLElement) {
        overlay.style.opacity = "1";
        overlay.style.pointerEvents = "auto";
      }
    });

    video.addEventListener("ended", () => {
      if (overlay instanceof HTMLElement) {
        overlay.style.opacity = "1";
        overlay.style.pointerEvents = "auto";
      }
    });
  }
</script>