---
import { ArrowRight, X } from "lucide-react";
import eddgeVideoSrc from "../assets/eddge-video3.mp4";
import thumbnail from "../assets/thumbnail.png";
---

<section
  id="videosection"
  class="relative py-12 md:py-16 overflow-hidden bg-gradient-to-b from-[color:var(--hero-bg-end)] to-surface transition-colors duration-200"
>
  <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 relative z-10">
    <!-- MAIN COMPACT CARD USING DYNAMIC VARIABLES -->
    <div
      class="relative rounded-[2rem] md:rounded-[2.5rem] overflow-hidden bg-[color:var(--video-card-bg)] shadow-[0_8px_30px_rgba(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.4)] border border-[color:var(--video-card-border)] flex flex-col md:flex-row items-center md:items-stretch min-h-[180px] md:h-[220px] transition-all duration-200"
    >
      <!-- BACKGROUND DECORATION (Right side DNA) -->
      <div
        class="absolute right-0 top-0 bottom-0 w-1/2 md:w-[55%] pointer-events-none overflow-hidden flex items-center justify-end z-0"
      >
        <svg
          class="w-full min-w-[500px] text-[color:var(--color-brand-blue)] opacity-[0.06] dark:opacity-[0.1] translate-x-12 md:translate-x-4 transition-opacity duration-200"
          viewBox="0 0 800 300"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <g transform="translate(0, 0)">
            <!-- DNA Strand 1 -->
            <path
              d="M -50 150 Q 100 30 200 150 T 450 150 T 700 150 T 950 150"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
            <!-- DNA Strand 2 -->
            <path
              d="M -50 150 Q 100 270 200 150 T 450 150 T 700 150 T 950 150"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>

            <!-- Rungs -->
            <g stroke="currentColor" stroke-width="1.5">
              <line x1="30" y1="131" x2="30" y2="169"></line>
              <line x1="60" y1="108" x2="60" y2="192"></line>
              <line x1="90" y1="92" x2="90" y2="208"></line>
              <line x1="120" y1="92" x2="120" y2="208"></line>
              <line x1="150" y1="108" x2="150" y2="192"></line>
              <line x1="180" y1="131" x2="180" y2="169"></line>

              <line x1="230" y1="169" x2="230" y2="131"></line>
              <line x1="260" y1="192" x2="260" y2="108"></line>
              <line x1="290" y1="208" x2="290" y2="92"></line>
              <line x1="320" y1="208" x2="320" y2="92"></line>
              <line x1="350" y1="192" x2="350" y2="108"></line>
              <line x1="380" y1="169" x2="380" y2="131"></line>

              <line x1="430" y1="131" x2="430" y2="169"></line>
              <line x1="460" y1="108" x2="460" y2="192"></line>
              <line x1="490" y1="92" x2="490" y2="208"></line>
              <line x1="520" y1="92" x2="520" y2="208"></line>
              <line x1="550" y1="108" x2="550" y2="192"></line>
              <line x1="580" y1="131" x2="580" y2="169"></line>

              <line x1="630" y1="169" x2="630" y2="131"></line>
              <line x1="660" y1="192" x2="660" y2="108"></line>
              <line x1="690" y1="208" x2="690" y2="92"></line>
              <line x1="720" y1="208" x2="720" y2="92"></line>
              <line x1="750" y1="192" x2="750" y2="108"></line>
              <line x1="780" y1="169" x2="780" y2="131"></line>
            </g>
            <!-- Dots at intersections -->
            <g fill="currentColor">
              <circle cx="200" cy="150" r="3.5"></circle>
              <circle cx="450" cy="150" r="3.5"></circle>
              <circle cx="700" cy="150" r="3.5"></circle>
            </g>
          </g>
        </svg>
      </div>

      <!-- LEFT: VIDEO THUMBNAIL -->
      <div
        class="p-3 md:p-4 w-full md:w-auto shrink-0 relative z-10 flex items-center justify-center"
      >
        <div
          class="relative w-full md:w-[280px] lg:w-[320px] aspect-[16/9] md:aspect-auto md:h-full rounded-[1.5rem] md:rounded-[2rem] overflow-hidden group shadow-sm bg-[color:var(--color-surface)]"
        >
          <video
            id="eddgeVideo"
            class="w-full h-full object-cover"
            poster={thumbnail.src}
            playsinline
            autoplay
            muted
            loop
          >
            <source src={eddgeVideoSrc} type="video/mp4" />
          </video>

          <!-- PLAY OVERLAY -->
          <div
            id="videoOverlay"
            class="absolute inset-0 flex items-center justify-center z-20 bg-black/5 group-hover:bg-black/10 transition-colors duration-300 cursor-pointer"
          >
          </div>
        </div>
      </div>

      <!-- CENTER: TEXT CONTENT -->
      <div
        class="flex-1 p-6 md:p-8 md:pl-6 flex flex-col justify-center relative z-10 text-center md:text-left"
      >
        <p
          class="text-[color:var(--color-brand-blue)] text-xs font-bold uppercase tracking-[0.1em] mb-2"
        >
          SEE HOW EDDGE WORKS
        </p>

        <h3
          class="text-2xl md:text-3xl font-bold text-[color:var(--color-brand-ink)] mb-1.5 leading-tight tracking-tight"
        >
          Sixty seconds. The full picture.
        </h3>

        <p
          class="text-[15px] md:text-base text-[color:var(--color-brand-muted)] dark:text-[color:var(--color-brand-muted)] mb-5 md:mb-6 font-medium transition-colors"
        >
          A quick walk through the Eddge journey, from your first call to your
          child's plan.
        </p>

        <div>
          <button
            id="inlinePlayBtn"
            class="inline-flex items-center cursor-pointer gap-1.5 text-[color:var(--color-brand-blue)] font-semibold hover:gap-2.5 transition-all duration-300 group text-[15px]"
          >
            Watch Video <ArrowRight
              size={18}
              className="transition-transform"
            />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- VIDEO MODAL -->
<div
  id="videoModal"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 opacity-0 pointer-events-none transition-opacity duration-300 backdrop-blur-sm"
>
  <div class="relative w-full max-w-5xl mx-auto px-4 sm:px-6">
    <div
      id="videoModalContent"
      class="relative w-full aspect-video bg-black rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl scale-95 transition-transform duration-300"
    >
      <video
        id="popupVideo"
        class="w-full h-full outline-none"
        controls
        playsinline
      >
        <source src={eddgeVideoSrc} type="video/mp4" />
      </video>
      <button
        id="closeModalBtn"
        class="absolute top-4 right-4 z-10 w-10 h-10 bg-black/40 hover:bg-black/60 backdrop-blur-md rounded-full flex items-center justify-center text-white transition-colors"
      >
        <X size={20} />
      </button>
    </div>
  </div>
</div>

<style is:global>
  :root {
    --video-card-bg: #fafbff;
    --video-card-border: #f1f5f9; /* Subtle light gray border */
  }

  html.dark {
    --video-card-bg: #111827; /* Matching dark deep paper variable */
    --video-card-border: #1f2937; /* Matches standard grey slate border */
  }
</style>

<script>
  const inlineVideo = document.getElementById("eddgeVideo") as HTMLVideoElement;
  const popupVideo = document.getElementById("popupVideo") as HTMLVideoElement;
  const playBtn = document.getElementById("playBtn");
  const inlinePlayBtn = document.getElementById("inlinePlayBtn");
  const overlay = document.getElementById("videoOverlay");
  const videoModal = document.getElementById("videoModal");
  const videoModalContent = document.getElementById("videoModalContent");
  const closeModalBtn = document.getElementById("closeModalBtn");

  const openModal = () => {
    if (!videoModal || !videoModalContent) return;

    // Open modal
    videoModal.classList.remove("pointer-events-none");
    videoModal.classList.add("opacity-100");
    videoModal.classList.remove("opacity-0");
    videoModalContent.classList.add("scale-100");
    videoModalContent.classList.remove("scale-95");

    // Pause inline video
    if (inlineVideo && !inlineVideo.paused) {
      inlineVideo.pause();
    }

    // Play popup video
    if (popupVideo) {
      popupVideo.currentTime = 0;
      popupVideo.play().catch((e) => console.log("Popup play prevented:", e));
    }
  };

  const closeModal = () => {
    if (!videoModal || !videoModalContent) return;

    // Close modal
    videoModal.classList.add("pointer-events-none");
    videoModal.classList.remove("opacity-100");
    videoModal.classList.add("opacity-0");
    videoModalContent.classList.remove("scale-100");
    videoModalContent.classList.add("scale-95");

    // Pause popup video
    if (popupVideo) {
      popupVideo.pause();
    }

    // Resume inline video
    if (inlineVideo && inlineVideo.paused) {
      inlineVideo
        .play()
        .catch((e) => console.log("Inline resume prevented:", e));
    }
  };

  playBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    openModal();
  });

  overlay?.addEventListener("click", openModal);
  inlinePlayBtn?.addEventListener("click", openModal);
  closeModalBtn?.addEventListener("click", closeModal);

  // Close on backdrop click
  videoModal?.addEventListener("click", (e) => {
    if (
      e.target === videoModal ||
      e.target === videoModalContent?.parentElement
    ) {
      closeModal();
    }
  });

  // Handle escape key
  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      videoModal &&
      !videoModal.classList.contains("pointer-events-none")
    ) {
      closeModal();
    }
  });
</script>
