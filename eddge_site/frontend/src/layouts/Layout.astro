---
// src/layouts/Layout.astro
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

const lightLogo = "/H Logo_Black.png";
const darkLogo = "/H Logo_White.png";
const footerLogoLight = "/Stack Logo_Blue.png";
const footerLogoDark = "/Stack Logo_White.png";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Built on two decades of work in child development and the trust of parents across India. Eddge gives you a clearer read on who your child is, and what they need next"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/eddge-logo.png" />
    <title>{title}</title>

    <!-- Inline script to apply dark mode early and prevent flashing -->
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return "dark";
      };

      const isDark = getThemePreference() === "dark";
      document.documentElement.classList.toggle("dark", isDark);
    </script>
  </head>
  <body
    class="bg-[color:var(--color-paper)] text-[color:var(--color-brand-ink)] transition-colors duration-200"
  >
    <NavBar lightLogo={lightLogo} darkLogo={darkLogo} />
    <slot />
    <Footer footerLogoLight={footerLogoLight} footerLogoDark={footerLogoDark} />
    <ScrollToTop />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  /* Tell Tailwind v4 to use class-based dark mode instead of OS media queries */
  @variant dark (&:where(.dark, .dark *));

  @import url("https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap");

  /* Standard Base Variables (No '--color-' prefix to prevent recursion) */
  :root {
    --raw-brand-blue: #248ac3;
    --raw-brand-blue-soft: rgba(36, 138, 195, 0.1);
    --raw-brand-ink: #0a0a0a;
    --raw-brand-muted: #64748b;
    --raw-paper: #f4f1e8;
    --raw-surface: #ffffff;
  }

  /* Overrides when .dark class is active on <html> */
  html.dark {
    --raw-brand-blue: #38bdf8;
    --raw-brand-blue-soft: rgba(56, 189, 248, 0.15);
    --raw-brand-ink: #f3f4f6;
    --raw-brand-muted: #94a3b8;
    --raw-paper: #111827;
    --raw-surface: #1f2937;
  }
  /* Gotham Font Faces... */
  @font-face {
    font-family: "Gotham";
    src: url("/fonts/gotham/Gotham-Light.otf") format("opentype");
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Gotham";
    src: url("/fonts/gotham/Gotham-Book.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Gotham";
    src: url("/fonts/gotham/Gotham-Medium.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Gotham";
    src: url("/fonts/gotham/Gotham-Bold.otf") format("opentype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Gotham";
    src: url("/fonts/gotham/Gotham-Black.otf") format("opentype");
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  @theme {
    --font-body: "Gotham", ui-sans-serif, system-ui, sans-serif;
    --font-heading: "Gotham", ui-sans-serif, system-ui, sans-serif;
    --font-ui: "Gotham", ui-sans-serif, system-ui, sans-serif;

    /* Map Tailwind's theme utility colors to our dynamic raw properties */
    --color-brand-blue: var(--raw-brand-blue);
    --color-brand-blue-soft: var(--raw-brand-blue-soft);
    --color-brand-ink: var(--raw-brand-ink);
    --color-brand-muted: var(--raw-brand-muted);
    --color-paper: var(--raw-paper);
    --color-surface: var(--raw-surface);
  }

  @layer base {
    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--raw-paper);
      font-family: var(--font-body);
      color: var(--raw-brand-ink);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      font-family: var(--font-heading);
    }

    button,
    input,
    select,
    textarea,
    label,
    nav,
    .primary-btn,
    .secondary-btn,
    .hero-badge,
    .trust-pill {
      font-family: var(--font-ui);
    }
  }
</style>
